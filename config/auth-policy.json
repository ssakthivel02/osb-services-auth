{
  "version": "1.0.0",
  "issuer": "https://auth.omsaravanabhava.org",
  "audiences": ["osb-api"],
  "accessTokenTtlSeconds": 900,
  "refreshTokenTtlSeconds": 604800,
  "clockSkewSeconds": 60,
  "allowedAlgorithms": ["RS256", "ES256"],
  "requirePkce": true,
  "requireState": true,
  "requireNonceForOidc": true,
  "rotateRefreshTokens": true,
  "revokeRefreshTokenFamilyOnReuse": true,
  "minimumPasswordLength": 14,
  "requireMfaForPrivilegedRoles": true,
  "maximumFailedAttempts": 5,
  "lockoutSeconds": 900,
  "sessionIdleTimeoutSeconds": 1800,
  "sessionAbsoluteTimeoutSeconds": 43200,
  "tenantClaim": "tenant_id",
  "subjectClaim": "sub",
  "requiredClaims": ["iss", "aud", "sub", "exp", "iat", "jti", "tenant_id"],
  "privilegedRoles": ["platform_admin", "tenant_admin", "security_admin"],
  "disallowedAlgorithms": ["none", "HS256", "HS384", "HS512"]
}
